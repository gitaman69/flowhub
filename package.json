{
  "name": "flowkit",
  "private": true,
  "version": "0.0.1",
  "description": "FlowKit monorepo root",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test && pnpm run test:integration",
    "test:integration": "pnpm --filter @flowhub/tests run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
