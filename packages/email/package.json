{
  "name": "@flowhub/email",
  "version": "0.0.1",
  "description": "Provider-agnostic email (Resend, SendGrid, SMTP, Mailgun, SES).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitaman69/flowhub.git",
    "directory": "packages/email"
  },
  "homepage": "https://github.com/gitaman69/flowhub/tree/main/packages/email#readme",
  "bugs": {
    "url": "https://github.com/gitaman69/flowhub/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flowhub/errors": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
